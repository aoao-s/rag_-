# EduRAG-Pro 环境变量模板：复制为 .env 后按需修改（.env 不进 git）
# 参数基线见 CLAUDE.md §6.3 与 §7，改阈值前先看那里的说明

# ---- 应用 ----
APP_ENV=dev
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# 文件里记更细的现场（缓存 key / SQL / 续命），控制台只看结论
LOG_FILE_LEVEL=DEBUG
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# ---- 日志（stdout + logs/app.log 轮转，见 CLAUDE.md §5.2）----
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10
# 是否把原始问法写进日志：生产建议 false
LOG_QUERY_TEXT=false

# ---- MySQL（端口/账号同时被 docker/docker-compose.yml 读取，只改这里）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=637456
MYSQL_DATABASE=rag_sbc
MYSQL_POOL_MAX=16

# ---- Redis（只放缓存/限流/会话热点；密码同时用于容器 --requirepass）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=1234
REDIS_DB=0

# ---- qa_system（CLAUDE.md §7.1.2）----
# 归一化分数阈值：(0,1)，bm25/(bm25+FAQ_NORM_K)
FAQ_THRESHOLD=0.25
# top1 与 top2 的最小间隔；含义随 FAQ_MARGIN_MODE 变
#   relative  =(raw1-raw2)/raw1（跨学科也可解释，重标定后的目标）
#   normalized=score1-score2（现网基线）
#   raw       =raw1-raw2（仅同一学科索引内可解释）
FAQ_MARGIN=0.10
FAQ_MARGIN_MODE=normalized
# 三档路由的高置信下限（CLAUDE.md §7.1.9）：与 FAQ_MARGIN **同一 FAQ_MARGIN_MODE 空间**解释。
#   margin ≥ FAQ_HIGH_MARGIN          → high，唯一允许直接作答的一档
#   FAQ_MARGIN ≤ margin < HIGH        → mid，跑 RAG + 追问；`FAQHit.answer` 仍为 None
#   设成与 FAQ_MARGIN 相等            → 精确回退为单档（灰度/回滚开关，不改代码）
FAQ_HIGH_MARGIN=0.22
# mid 档的 top3 问答对是否作为**辅助上下文**进生成 prompt（2026-10-31 修订，§7.1.9 边界 2）。
#   进：单独一条 system 消息，用「候选N：」编号（不是 [n]），不占【资料】、不进 citations；
#   出：等于回到旧行为（mid 的 FAQ 原文一个字都不进生成器）。这是本改动的回滚开关与 A/B 分组
FEATURE_FAQ_CANDIDATES=true
# 候选数下限：只有 1 条候选时"领先第二名"无意义，直接不算命中
FAQ_MIN_CANDIDATES=2
# 多学科：主学科 best 与另一学科 best 的归一化分差下限
FAQ_CROSS_SUBJECT_DELTA=0.05
FAQ_TOP_K=20
FAQ_NORM_K=12.0
# 未命中时回给 RAG 的候选问法条数
FAQ_CANDIDATE_N=3
FAQ_ALIAS_ENABLED=true
# 语料重复合并：同学科 + 答案逐字相同 + 去问句框架词后 Jaccard ≥0.8 的 FAQ 并成一条（只留最小 id 进索引）
# 置 false 仅用于对照实验；生产保持 true
FAQ_DEDUPE_NEAR_DUP=true
# 本地无数据库时从 CSV 装载语料（相对仓库根）；生产留空
FAQ_CORPUS_CSV=
# 生产必须设置；为空时写接口只允许本机调试
FAQ_ADMIN_TOKEN=

# ---- 启动行为 ----
# dev 允许数据库不可用时以空语料启动（/readyz 标记 degraded）；生产必须 false
ALLOW_DEGRADED_START=true

# ---- FAQ 二级缓存（Redis 热数据，MySQL 仍是真相源）----
FAQ_CACHE_ENABLED=true
FAQ_CACHE_TTL=3600
# 绝对寿命上限：滑动续命不能无限延长
FAQ_CACHE_MAX_TTL=21600
FAQ_CACHE_SLIDE_RATIO=0.5
FAQ_CACHE_NEGATIVE_TTL=30

# ---- Milvus（PR3 知识库）----
MILVUS_URI=http://127.0.0.1:19541
MILVUS_DATABASE=edurag
MILVUS_COLLECTION=edurag_chunk
# 原子记忆的向量集合（§3.7 第 8 条）。与知识库集合分开：一个是可重建的索引，
# 一个是用户数据，重建知识库时不该把记忆一起 drop。
MILVUS_MEMORY_COLLECTION=edurag_memory
MILVUS_DIM=1024

# ---- RAG 切分与向量化 ----
RAG_DOCS_DIR=datasets/初高中教材教案试卷-按年级
RAG_PARENT_SIZE=1200
RAG_PARENT_OVERLAP=100
RAG_CHILD_SIZE=300
RAG_CHILD_OVERLAP=20
# auto=有模型用真模型；hash=确定性哈希，只验证管线
RAG_EMBED_BACKEND=auto
RAG_EMBED_MODEL_PATH=rag_system/models/BAAI/bge-m3
RAG_RERANKER_PATH=rag_system/models/BAAI/bge-reranker-v2-m3
RAG_EMBED_DEVICE=auto
RAG_EMBED_FP16=true
RAG_EMBED_BATCH_SIZE=8
RAG_USE_FP16=true
RAG_RERANK_ENABLED=auto
RAG_RERANK_CANDIDATES=40
RAG_RERANK_CHARS=2000
# ---- 证据门（默认值是黄金集标定结果，改语料/改嵌入模型必须重标）----
RAG_EVIDENCE_THRESHOLD=0.74
RAG_EVIDENCE_MARGIN=0.01
RAG_EVIDENCE_MIN_DOCS=1
RAG_EVIDENCE_QCOV=0.20
# ---- 生成层 LLM 网关（OpenAI 兼容 /chat/completions，CLAUDE.md §7.8）----
# 留空不阻断启动：/v1/chat 走兜底话术，FAQ 与 RAG 照常；生产用 ALLOW_DEGRADED_START=false 兜住
# 密钥只从环境注入，**本文件不写真实 key**（模板会被提交进库）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_QA_MODEL=deepseek-chat
# 首 token / 连接失败时换这个模型（空 = 不换）；换模型算降级，不算重试
LLM_FALLBACK_MODEL=
LLM_ROUTER_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# 网关级有限重试次数（0–3，默认 1）：只重试超时 / 连接中断 / 408 / 429，
# 一个字都没生成前的同一次请求重发；4xx 与 5xx 不重试（5xx 直接换模型）
LLM_MAX_RETRIES=1
# ---- 本地小模型（闲聊档专用，CLAUDE.md §7.7）----
# 闲聊不检索、不引用，一句"你好"付一次云端往返与计费不划算，改走本地 Ollama。
# 与上面的主网关**完全独立**：端点 / 模型 / key / 超时各一份；本地不可用时闲聊回落主网关。
# 端点必须是 Ollama 的 OpenAI 兼容层（带 /v1）
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_MODEL=qwen3.5:0.8b
# 本地 Ollama 不校验 key；留空即不发 Authorization 头
LLM_LOCAL_API_KEY=
# 比云端短：本地小模型要么很快，要么就是卡住了
LLM_LOCAL_TIMEOUT_S=30
# qwen3.5:0.8b 是**思考型**模型：默认 token 全花在 reasoning 上、content 恒为空。
# 实测只有 reasoning_effort=none 被 /v1/chat/completions 认（think:false 等都被静默忽略）。
# 置空 = 不发这个字段——但那样本地模型会稳定返回空答案，闲聊直接走兜底。
LLM_LOCAL_REASONING_EFFORT=none
# ---- 理解层开关（查询改写 / 意图识别 / 年级下推，CLAUDE.md §3.2 §7.7）----
# 意图识别总开关；关掉 = 用 BASELINE 档位（不收窄、必检索、必引用），也是档位 A/B 的基线
FEATURE_INTENT=true
# 意图识别用大模型（与查询改写合并成**一次**调用）；关掉回落 understanding/intent.py 的规则分类器
# ⚠ §7.8.4 的 macro F1 0.967 / unknown 5.59% 与档位 A/B 报告都是**规则分类器**量的，
#   打开本开关后这些数字不再描述线上行为
FEATURE_INTENT_LLM=true
# BERT 精调分类器做**初始**意图（任务 2.2）：置信度够就直接定档，一次大模型调用都不发；
# 不够才交给大模型辅助判断。检查点缺失 / 标签映射对不上时自动跳过，关掉即回到"大模型 → 规则"
FEATURE_INTENT_BERT=true
# BERT 推理硬上限（毫秒）：超时放弃这条结论让大模型接手，不拖住首 token
INTENT_BERT_TIMEOUT_MS=200
# 大模型查询改写（在**身份与权限之后**、检索之前；FAQ 也排在权限之后，见 §7.4 的实际时序）；
# 关掉只保留确定性归一化（NFKC / 空白 / 重复标点折叠）
FEATURE_QUERY_REWRITE=true
# 槽位抽到的年级/学段下推成 Milvus 标量过滤；年级误抽时用它一键回滚
FEATURE_GRADE_FILTER=true
# 槽位的"模型补空"（任务 2.3）：章节名 / 知识点 / 任务参数走大模型，
# 学科 / 年级 / 教材版本 / 学期**永远走规则**（模型抽错会把正确答案挡在索引外）
FEATURE_SLOT_LLM=true
# 必要槽位缺失时先追问一句再执行（默认关闭：先按"不拦"发布，用真实流量判断该不该开）
FEATURE_SLOT_CLARIFY=false
# 检索策略（direct / sub_query / hyde）交给大模型选，与上面的改写/意图/槽位合并成同一次调用。
# **只换"选哪种检索方式"**：no_retrieval（这个意图不检索）与 clarify（指代解不开要追问）
# 仍由规则判——那是结构事实，不是偏好。关掉 = 纯规则规划，与加开关之前逐字节一致
FEATURE_PLANNER_LLM=true
# 归一化 + 一次大模型理解的预算上限（毫秒），必须小于 TOTAL_BUDGET_MS。
# 注意它会挤压首 token 预算，SLO 需重测（§6.1）
UNDERSTANDING_TIMEOUT_MS=800
# ---- HyDE（阶段 4.3，2026-11-01 交给 DeepSeek）----
# 短且抽象的问句（"什么是X"）先让生成模型写一段"假设性答案"，再拿它去检索。
# 默认开。**如实记录**：它会多付一次生成调用，且"召回有没有变好"没有黄金集对照数据
# （§5.4 要求的报告未跑）；HyDE 文本永远不进证据集合，只影响"拿哪句话去检索"。
# 置 false = 规划层不选 HYDE，短抽象问句照旧走 DIRECT
FEATURE_HYDE=true
# 生成假设文的硬上限（毫秒）。**不要拿 LLM_TIMEOUT_S 当它**：60 s 等于没有上限，
# 一次慢调用会把 TOTAL_BUDGET_MS 吃穿。超时即退回 DIRECT 用原句检索
HYDE_BUDGET_MS=1500
# ---- 复合问句拆分（任务 2.4，2026-11-01 交给本地小模型）----
# 意图判完之后，把"比较A和B的区别，并分别出三道题"拆成可各自检索的子问句。
# 本地端点见上面的 LLM_LOCAL_*：不计费、不出网。拆不出来（模型没给 / 给了但其实
# 是改写过的词）一律退回规则拆分，并把原因记进 degraded——**不猜、不编词**。
# 置 false = 纯规则拆分，与接模型之前逐字节一致（回滚开关 / A/B 分组）
FEATURE_COMPOUND_LLM=true
# 拆分调用的硬上限（毫秒）。到点即退回规则：0.8B 的本地模型几十毫秒就该出结果，
# 慢到需要等这一步的问句，本来也不值得为它拖住首 token
COMPOUND_TIMEOUT_MS=400
# ---- 编排层 /v1/chat ----
TOTAL_BUDGET_MS=8000
# 请求体字节上限（阶段 1 §3.5）。超限回 413，**不是**把长文截断后照答：
# 截断会把"用户问了一长段"变成"系统答了半句"。64 KB 足够放下 400 字的问句 + 全部可选字段
MAX_REQUEST_BYTES=65536
# 问句字符上限（400 = 400 query_too_long）。与上面这条是两层：前者按字节兜住整个 body，
# 后者按用户可见的"多少个字"给出可解释的拒绝原因
CHAT_MAX_QUERY_CHARS=400
# ---- 鉴权（阶段 1 §3.2）----
# 为空则关闭 JWT 分支，只走白名单环境的开发期请求头（生产必须配置）
# 只支持 HS256，stdlib 实现，不引第三方库
# 强制登录必填：请生成至少 32 字节随机密钥，例如 Python: secrets.token_urlsafe(48)
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_LEEWAY_S=60
# ---- 业务权限（阶段 3：角色 × 意图）----
# 判定在 orchestration/admission.py::permissions_for()，结论在**身份确定之后、FAQ 之前**生效。
# 角色只能从令牌 / 服务端上下文来，请求体里写 role 会被 400 拒掉（auth/api.py 的 extra="forbid"）。
# 置 false = 空拒绝集，整条门禁不存在——紧急回滚用，与 FEATURE_INTENT 同一角色
FEATURE_PERMISSION=true
# ---- 账号与令牌（auth/）----
# access_token 有效期（秒）。默认 600 = 10 分钟（用户决定）：登出只作废 refresh，
# access 是无状态的，只能靠短 TTL 自然死亡——把这里调长等于放宽"登出后旧 access 还能用"的窗口
AUTH_ACCESS_TTL_S=600
# refresh_token 有效期（秒）：默认 7 天，勾选 remember_me 时 30 天
AUTH_REFRESH_TTL_S=604800
AUTH_REFRESH_TTL_REMEMBER_S=2592000
# 句级引用支持度下限：句子实词被所引证据覆盖的比例低于它就算"无支撑句"，整段拒答
CITATION_MIN_SUPPORT=0.30
# 兜底话术里的联系方式；留空只说"联系课程顾问"，不要编造电话号码
CHAT_SUPPORT_CONTACT=
# ---- 会话与记忆（CLAUDE.md §7.9）----
# 总开关：关掉等于"无会话、无记忆"的老行为（灰度与排障用）
FEATURE_MEMORY=true
# L2 原子记忆的向量召回；关掉或 RAG 未就绪时退回字面排序（功能降级，不是故障）
FEATURE_MEMORY_VECTOR=true
# L0 窗口双上限：40 轮或 28 000 token，先到先压
MEM_WINDOW_TURNS=40
MEM_WINDOW_TOKENS=28000
MEM_COMPRESS_BATCH_TURNS=10
MEM_SUMMARY_MAX_TOKENS=400
# L2 原子记忆：召回条数 / 置信度门槛 / 合并阈值 / 单用户活跃上限（到上限拒绝新增，不淘汰）
MEM_RECALL_TOP_K=5
MEM_MIN_CONFIDENCE=0.60
MEM_DEDUPE_SIM=0.92
MEM_ATOM_LIMIT_PER_USER=500
# 记忆段注入 prompt 的 token 预算：画像 300 / 摘要 400 / 原子 300
MEM_PROFILE_MAX_TOKENS=300
MEM_ATOM_MAX_TOKENS=300
# 召回超时（到点返回空记忆 + degraded，主链路继续）
MEM_RECALL_BUDGET_MS=120
# 会话在 Redis 里的留存时间
MEM_SESSION_TTL_S=86400
# 物理清理窗口（天）与单批删除行数；scripts/purge_memory.py 读这两个值。
# 窗口只此一个：memory_atom 按 deleted_at 算（valid_to 是历史链，不算删除），
# chat_message 按 created_at、session_summary 按 updated_at
MEM_PURGE_AFTER_DAYS=30
MEM_PURGE_BATCH=2000

# ---- MinerU（PDF 解析，云端 API）----
# 没有 token 时 PDF 会直接报错，不会静默跳过
MINERU_TOKEN=put-your-mineru-token-here
MINERU_BASE=https://mineru.net/api/v4
MINERU_MODEL=vlm
MINERU_POLL_INTERVAL=5
MINERU_TIMEOUT_S=900
# 上传超时单独一根：教材最大 66 MB，沿用 120 s 的通用 HTTP 超时会在慢上行链路上必然
# 写超时并静默退成本地 PyMuPDF（解析质量更低）。连不上仍然 30 s 失败，不干等
MINERU_UPLOAD_TIMEOUT_S=900
MINERU_CACHE_DIR=data/mineru
# PDF 解析器：auto=有 token 走 MinerU、失败自动退本地 PyMuPDF；mineru=只用云；local=只用本地
RAG_PDF_PARSER=auto
# Office/图片里的内嵌图是否 OCR（慢且贵，默认关闭）
RAG_OCR_IMAGES=false
# 近重复文档检测（§7.2.6）：同一本教材两次下载会让同一段证据互为对手，证据门直接判 ambiguous
RAG_DEDUP_ENABLED=true
# 64 位 simhash 汉明距离上限；3 拦住"换页眉/换标点"的同一份，不会误伤同学科不同教材
RAG_DEDUP_DISTANCE=3
# 取正文前多少字符算指纹（差异多在页眉水印，开头足够）
RAG_DEDUP_PREFIX_CHARS=8000



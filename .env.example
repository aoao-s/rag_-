# EduRAG-Pro 环境变量模板：复制为 .env 后按需修改（.env 不进 git）
# 参数基线见 CLAUDE.md §6.3 与 §7，改阈值前先看那里的说明

# ---- 应用 ----
APP_ENV=dev
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# ---- MySQL（docker-compose 默认 root/123456，库名 itcast 与旧项目保持一致）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=itcast
MYSQL_POOL_MAX=16

# ---- Redis（只放缓存/限流/会话热点，丢了不影响正确性）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- qa_system（CLAUDE.md §7.1.2）----
# 归一化分数阈值：(0,1)，bm25/(bm25+FAQ_NORM_K)
FAQ_THRESHOLD=0.62
# top1 与 top2 的最小间隔，防止两个问法分数接近时误答
FAQ_MARGIN=0.05
FAQ_TOP_K=20
FAQ_NORM_K=12.0
# 未命中时回给 RAG 的候选问法条数
FAQ_CANDIDATE_N=3
FAQ_ALIAS_ENABLED=true
# 生产必须设置；为空时写接口只允许本机调试
FAQ_ADMIN_TOKEN=

# ---- 启动行为 ----
# dev 允许数据库不可用时以空语料启动（/readyz 标记 degraded）；生产必须 false
ALLOW_DEGRADED_START=true
